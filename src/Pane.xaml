<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource PanelBrush}" CornerRadius="13" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" ClipToBounds="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="PaneHeader" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}" CornerRadius="12,12,0,0">
            <Grid Margin="12,0,8,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border x:Name="Grab" Background="Transparent" Cursor="SizeAll" ToolTip="拖动聊天框来换位">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="GrabMark" Text="⠿" Foreground="{DynamicResource MutedBrush}" FontSize="19" Margin="0,0,9,0" VerticalAlignment="Center" />
                        <ContentControl x:Name="ProviderIcon" Visibility="Collapsed" IsHitTestVisible="False" Focusable="False" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                        <Border x:Name="MainTag" Background="{DynamicResource BubbleBrush}" CornerRadius="5" Margin="8,0,0,0" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="主 Agent" FontSize="10" Foreground="{DynamicResource TextBrush}" />
                        </Border>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="Activity" Visibility="Collapsed" FontSize="10" Margin="3,0,4,0" VerticalAlignment="Center" />
                    <Button x:Name="PaneOptions" Style="{DynamicResource QuietButton}" Content="⋯" FontSize="17" MinWidth="30" Padding="5,0"
                            AutomationProperties.Name="聊天框菜单" ToolTip="移动或关闭聊天框" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="Messages" Margin="15,13,15,4" />
            </ScrollViewer>
            <StackPanel x:Name="ChooseAgent" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                <TextBlock Text="选择主 Agent" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" />
                <UniformGrid x:Name="AgentChoices" Columns="2" Width="312" Margin="0,12,0,0" />
            </StackPanel>
            <TextBlock x:Name="EmptyConversation" Text="发条消息开始对话。" Foreground="{DynamicResource MutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>

        <Border x:Name="InputArea" Grid.Row="2" CornerRadius="9" Margin="11,5,11,11" Background="{DynamicResource InputBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="3">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="Composer" AutomationProperties.Name="写消息" Style="{DynamicResource EditorTextBox}" MinHeight="37" MaxHeight="95" Padding="8,8,3,7"
                         BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                         AcceptsReturn="True" TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" />
                <TextBlock x:Name="Placeholder" Text="写消息…" Foreground="{DynamicResource MutedBrush}" Margin="10,0,3,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" />
                <Button x:Name="SendButton" Grid.Column="1" Style="{DynamicResource AccentButton}" Content="发送" IsEnabled="False"
                        VerticalAlignment="Bottom" MinWidth="53" Margin="4,1,1,1" ToolTip="发送 (Enter) · 换行 (Shift+Enter)" />
                <Button x:Name="StopButton" Grid.Column="2" Style="{DynamicResource AccentButton}" Content="停止" Visibility="Collapsed" AutomationProperties.Name="停止请求"
                        VerticalAlignment="Bottom" MinWidth="43" Margin="2,1,1,1" ToolTip="停止本轮并取消排队消息" />
                <Button x:Name="AgentSettingsButton" Grid.Row="1" Grid.ColumnSpan="3" Style="{DynamicResource QuietButton}"
                        Visibility="Collapsed" HorizontalAlignment="Left" MinHeight="21" FontSize="11" Padding="6,1"
                        Margin="1,2,1,0" Foreground="{DynamicResource MutedBrush}" AutomationProperties.Name="Agent 模型与模式"
                        ToolTipService.ShowOnDisabled="True">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right" Text="⌄" Margin="5,0,0,0" />
                        <TextBlock x:Name="AgentSettingsCaption" Text="模型与模式" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Border>
